# Required
TMDB_API_KEY=your_tmdb_api_key_here

# Optional — TVDB is used as a fallback for TV episode titles
TVDB_API_KEY=

# Library paths (match your Docker bind-mount targets)
TV_LIBRARY_PATH=/mnt/storage/TV Shows
MOVIES_LIBRARY_PATH=/mnt/storage/Movies

# Set to true to log intended actions without moving/deleting any files
DRY_RUN=false

LOG_LEVEL=INFO

# Run a full library scan when the service starts
SCAN_ON_START=true

# Files smaller than this (MB) are ignored (skips samples, trailers)
MIN_FILE_SIZE_MB=100
